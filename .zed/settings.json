{
  "terminal": {
    "env": {
      "PYTHONPATH": "./apps/api:./apps/api/src",
    },
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python.pythonPath": "apps/api/.venv/bin/python",
        "python.analysis": {
          "extraPaths": ["apps/api/src"],
          "diagnosticMode": "workspace",
          "typeCheckingMode": "strict",
        },
      },
    },
  },
  "languages": {
    "Python": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "-"],
        },
      },
      "language_servers": ["pyright"],
    },
  },
  "context_servers": {
    "nixos": {
      "command": "uvx",
      "args": ["mcp-nixos"],
    },
    "pypi": {
      "command": "uvx",
      "args": ["pypi-query-mcp-server"],
    },
    "langfuse-docs": {
      "command": "bunx",
      "args": ["mcp-remote", "https://langfuse.com/api/mcp"],
    },
    "supabase-local-dev-server": {
      "command": "bunx",
      "args": ["mcp-remote", "http://127.0.0.1:54321/mcp"],
    },
  },
}
